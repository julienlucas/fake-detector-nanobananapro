{
  "manifest_version": 3,
  "name": "FakeFinder - Détecteur d'Images IA",
  "version": "1.0.0",
  "description": "Détecte si une image a été générée par une IA (Midjourney, DALL-E, Stable Diffusion) ou si elle est réelle",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://fakefinder.vercel.app/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/favicon-16x16.png",
      "48": "icons/android-icon-48x48.png",
      "128": "icons/apple-icon-144x144.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/favicon-16x16.png",
    "48": "icons/android-icon-48x48.png",
    "128": "icons/apple-icon-144x144.png"
  }
}
